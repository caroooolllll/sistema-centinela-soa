# ============================================================
# Centinela — Variables de Entorno
# ------------------------------------------------------------
# 1. Copia este archivo:  cp .env.example .env
# 2. Rellena los valores reales en .env
# 3. NUNCA subas .env a git (ya está en .gitignore)
# ============================================================

# ── IA (Anthropic Claude) ──────────────────────────────────
# Obtén tu key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-REEMPLAZA_CON_TU_API_KEY

# ── Django ─────────────────────────────────────────────────
# Genera una clave segura con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-secreta-aleatoria-de-50-chars

# En desarrollo pon True, en producción False
DEBUG=True

# Hosts permitidos (separados por coma). En producción pon tu dominio real.
ALLOWED_HOSTS=0.0.0.0,localhost,127.0.0.1

# ── Email Gmail SMTP ───────────────────────────────────────
# Usa una "App Password" (NO tu contraseña normal de Google)
# Cómo crearla: https://myaccount.google.com/apppasswords
#   1. Ve a tu cuenta Google → Seguridad → Verificación en 2 pasos
#   2. Al final de esa página: "Contraseñas de aplicaciones"
#   3. Crea una para "Correo / Windows" y copia los 16 caracteres
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# ── URLs entre servicios ───────────────────────────────────
# URL del backend Django (auth + IA) — usada por el chat
CENTINELA_URL=http://localhost:9000
# URL base del frontend — aparece en los links del email de recuperación
CENTINELA_FRONTEND_URL=http://localhost:9002/frontend

# ── Chat (FastAPI :9003) ───────────────────────────────────
CHAT_HOST=0.0.0.0
CHAT_PORT=9003
CHAT_RELOAD=false

# ── Asistente rápido (Groq -> Gemini -> Claude -> local) ───
# Groq (gratis): https://console.groq.com/keys  — Whisper + LLM con streaming
GROQ_API_KEY=pega_tu_key_aqui
# Google AI Studio (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_tu_key_aqui
# Orden de la cadena de respaldo (quita o reordena proveedores si quieres)
ASISTENTE_CADENA=groq,gemini,claude,local
# Modelos (opcionales; estos son los valores por defecto)
GROQ_MODELO=llama-3.3-70b-versatile
GROQ_STT_MODELO=whisper-large-v3-turbo
GEMINI_MODELO=gemini-2.0-flash
CLAUDE_MODELO=claude-sonnet-4-5
TTS_VOZ=es-MX-DaliaNeural
# Segundos máximos de espera ante un 429 "por minuto" antes de saltar al siguiente proveedor
ASISTENTE_ESPERA_429_MAX=4
# URL del SDRI para que el asistente consulte los avisos recientes
SDRI_URL=http://127.0.0.1:9001
